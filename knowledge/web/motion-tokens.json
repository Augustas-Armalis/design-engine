  },

  "spring": {
    "note": "Motion duration-style params. damping ratio zeta = 1 - bounce. stiffness = (2*pi/(visualDuration*1.2))^2, damping = 2*zeta*sqrt(stiffness) (mass 1). settleMs = time to stay within 1%.",
    "bounceCeiling": { "product": 0.2, "playful": 0.3, "absolute": 0.3 },
    "presets": {
      "press":    { "type": "spring", "visualDuration": 0.15, "bounce": 0,   "stiffness": 1218, "damping": 70,   "settleMs": 190, "src": "engine" },
      "small":    { "type": "spring", "visualDuration": 0.2,  "bounce": 0,   "stiffness": 685,  "damping": 52,   "settleMs": 255, "src": "engine" },
      "medium":   { "type": "spring", "visualDuration": 0.25, "bounce": 0,   "stiffness": 439,  "damping": 42,   "settleMs": 320, "src": "engine" },
      "layout":   { "type": "spring", "visualDuration": 0.3,  "bounce": 0,   "stiffness": 305,  "damping": 35,   "settleMs": 380, "src": "engine" },
      "panel":    { "type": "spring", "visualDuration": 0.4,  "bounce": 0,   "stiffness": 171,  "damping": 26,   "settleMs": 510, "src": "engine" },
      "release":  { "type": "spring", "visualDuration": 0.3,  "bounce": 0.2, "stiffness": 305,  "damping": 27.9, "settleMs": 360, "overshootPct": 1.5, "src": "blog (Apple ~80% damping for momentum)" },
      "playful":  { "type": "spring", "visualDuration": 0.3,  "bounce": 0.3, "stiffness": 305,  "damping": 24.4, "settleMs": 375, "overshootPct": 4.5, "src": "engine" }
    },
    "avoid": [
      { "name": "motion-implicit-xy", "stiffness": 500, "damping": 25, "zeta": 0.56, "why": "Motion's implicit transform spring, ~12% overshoot, looks templated", "src": "verified" },
      { "name": "motion-spring-default", "stiffness": 100, "damping": 10, "zeta": 0.5, "why": "slow (~880ms) and ~16% overshoot", "src": "verified" }
    ],
    "material3": {
      "standard": {
        "fastSpatial":    { "dampingRatio": 0.9, "stiffness": 1400 },
        "defaultSpatial": { "dampingRatio": 0.9, "stiffness": 700 },
        "slowSpatial":    { "dampingRatio": 0.9, "stiffness": 300 },
        "fastEffects":    { "dampingRatio": 1.0, "stiffness": 3800 },
        "defaultEffects": { "dampingRatio": 1.0, "stiffness": 1600 },
        "slowEffects":    { "dampingRatio": 1.0, "stiffness": 800 }
      },
      "expressive": {
        "fastSpatial":    { "dampingRatio": 0.6, "stiffness": 800 },
        "defaultSpatial": { "dampingRatio": 0.8, "stiffness": 380 },
        "slowSpatial":    { "dampingRatio": 0.8, "stiffness": 200 },
        "fastEffects":    { "dampingRatio": 1.0, "stiffness": 3800 },
        "defaultEffects": { "dampingRatio": 1.0, "stiffness": 1600 },
        "slowEffects":    { "dampingRatio": 1.0, "stiffness": 800 }
      },
      "src": "verified"
    },
    "cssLinear": {
      "note": "sampled from the same model; fixed duration, no velocity inheritance; use for hover/enter only",
      "snappy": { "duration": 210, "linear": "linear(0, 0.034, 0.114, 0.216, 0.325, 0.432, 0.531, 0.619, 0.696, 0.76, 0.814, 0.856, 0.891, 0.919, 0.941, 0.957, 0.97, 0.98, 0.987, 0.992, 1)" },
      "bouncy": { "duration": 400, "linear": "linear(0, 0.053, 0.176, 0.331, 0.489, 0.636, 0.76, 0.859, 0.933, 0.985, 1.018, 1.036, 1.044, 1.045, 1.041, 1.035, 1.028, 1.021, 1.014, 1.009, 1)" },
      "gentle": { "duration": 570, "linear": "linear(0, 0.057, 0.176, 0.312, 0.443, 0.559, 0.657, 0.736, 0.8, 0.849, 0.887, 0.916, 0.938, 0.954, 0.966, 0.975, 0.982, 0.987, 0.99, 0.993, 1)" }
    }
  },

  "m3Duration": {
    "short1": 50, "short2": 100, "short3": 150, "short4": 200,
    "medium1": 250, "medium2": 300, "medium3": 350, "medium4": 400,
    "long1": 450, "long2": 500, "long3": 550, "long4": 600,
    "extraLong1": 700, "extraLong2": 800, "extraLong3": 900, "extraLong4": 1000,
    "src": "verified"
