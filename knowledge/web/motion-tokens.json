  "stagger": {
    "list":      { "step": 50,  "maxItems": 8,  "maxTotal": 400,  "src": "blog (30-80ms)" },
    "chunks":    { "step": 100, "maxItems": 6,  "maxTotal": 600,  "src": "blog (~100ms)" },
    "hero":      { "step": 80,  "startDelay": 50, "maxTotal": 1200, "src": "engine" },
    "grid":      { "step": 40,  "from": "first", "maxTotal": 500, "src": "engine" },
    "forbiddenFor": ["keyboard-initiated", "filter/sort updates", "tab switches", "high-frequency UI"],
    "motion": "delayChildren: stagger(<seconds>, { startDelay, from })",
    "css": "animation-delay: calc(var(--i) * <step>ms) with --i clamped"
  },

  "transform": {
    "pressScale": { "value": 0.97, "min": 0.95, "max": 0.98, "src": "blog" },
    "enterFromScale": { "tooltip": 0.97, "popover": 0.95, "modal": 0.96, "toast": 0.95, "never": 0, "src": "blog" },
    "enterOffset": { "micro": 4, "small": 8, "medium": 16, "large": 24, "src": "engine" },
    "exitOffset": { "factorOfEnter": 0.5, "src": "blog" },
    "hoverLift": { "px": 2, "scale": 1.02, "max": 1.05, "gate": "(hover: hover) and (pointer: fine)", "src": "blog/engine" },
    "blurMask": { "px": 2, "max": 20, "src": "blog" }
  },

  "role": {
    "hover":      { "enter": 120, "exit": 120, "easing": "ease", "props": ["color", "background-color", "border-color", "box-shadow"], "motionAllowed": "low-frequency only", "src": "blog/engine" },
    "hoverLiftLanding": { "enter": 150, "exit": 350, "easing": "out", "props": ["transform"], "gate": "hover:hover", "src": "blog" },
    "press":      { "enter": 100, "exit": 160, "easing": "out", "spring": "press", "transform": { "scale": 0.97 }, "src": "blog" },
    "toggle":     { "enter": 120, "exit": 120, "easing": "out", "spring": "press", "src": "blog" },
    "tooltip":    { "enter": 125, "exit": 100, "easing": "out", "transform": { "scale": 0.97, "opacity": [0, 1] }, "origin": "trigger", "openDelay": 500, "subsequentDelay": 0, "subsequentAnimation": false, "src": "blog/engine" },
    "popover":    { "enter": 180, "exit": 120, "easing": "out", "spring": "small", "transform": { "scale": 0.95, "opacity": [0, 1] }, "origin": "trigger", "src": "blog" },
    "menu":       { "enter": 150, "exit": 100, "easing": "out", "transform": { "scale": 0.95, "opacity": [0, 1] }, "origin": "trigger", "src": "blog" },
    "select":     { "enter": 180, "exit": 120, "easing": "out", "transform": { "scale": 0.95, "opacity": [0, 1] }, "origin": "trigger", "src": "blog" },
    "modal":      { "enter": 250, "exit": 170, "easing": "out", "transform": { "scale": 0.96, "translateY": 8, "opacity": [0, 1] }, "origin": "center", "backdrop": { "enter": 200, "exit": 150, "easing": "linear" }, "src": "blog/engine" },
    "drawer":     { "enter": 500, "exit": 350, "easing": "drawer", "spring": "panel", "transform": { "translateY": "100%" }, "gestureTracked": true, "src": "blog" },
    "sidePanel":  { "enter": 280, "exit": 200, "easing": "m3Standard", "transform": { "translateX": "100%" }, "src": "engine" },
    "toast":      { "enter": 400, "exit": 250, "easing": "ease", "transform": { "translateY": "100%" }, "stack": { "offsetPx": 14, "scaleStep": 0.05 }, "display": 4000, "pauseOnHover": true, "pauseOnHidden": true, "swipeVelocity": 0.11, "src": "blog" },
    "accordion":  { "enter": 220, "exit": 180, "easing": "out", "src": "engine" },
    "tabIndicator": { "enter": 220, "easing": "inOut", "spring": "layout", "shared": "layoutId", "src": "engine" },
    "listReorder": { "spring": "layout", "exit": 150, "src": "engine" },
    "listItem":   { "enter": 200, "exit": 150, "easing": "out", "transform": { "translateY": 8, "opacity": [0, 1] }, "src": "engine" },
    "pageTransitionApp": { "enter": 250, "exit": 150, "easing": "m3Standard", "transform": { "translateY": 8, "opacity": [0, 1] }, "viewTransition": 280, "src": "engine" },
    "pageTransitionMarketing": { "enter": 400, "exit": 250, "easing": "m3EmphasizedDecelerate", "src": "engine" },
    "heroEntrance": { "enter": 700, "easing": "outExpo", "transform": { "translateY": 20, "opacity": [0, 1] }, "stagger": "hero", "implementation": "CSS keyframes, fill-mode both, visible without JS", "lcpRule": "do not hide the LCP element with opacity 0 for more than 150ms", "src": "engine" },
    "scrollReveal": { "enter": 600, "easing": "out", "transform": { "translateY": 20, "opacity": [0, 1] }, "trigger": { "amount": 0.25, "once": true, "rootMargin": "0px 0px -10% 0px" }, "exit": "none", "src": "engine" },
    "scrollScrub": { "easing": "linear", "props": ["transform", "opacity"], "smoothing": { "gsapScrub": 1, "motionSpring": { "stiffness": 300, "damping": 40, "mass": 0.5 } }, "css": "animation-timeline: scroll()/view(); animation-range: entry 0% cover 35%", "src": "engine" },
    "viewTransition": { "duration": 280, "easing": "m3Standard", "src": "engine" },
    "skeleton":   { "shimmer": 1600, "easing": "linear", "showAfter": 250, "minVisible": 400, "swapFade": 180, "src": "engine" },
    "spinner":    { "rotate": 900, "easing": "linear", "src": "blog" },
    "success":    { "duration": 450, "spring": "playful", "frequency": "rare only", "src": "engine" }
  },

  "frequencyPolicy": {
    "src": "blog (Emil Kowalski)",
    "rules": [
      { "frequency": "100+/day or keyboard-initiated", "motion": "none" },
      { "frequency": "tens/day (hover, list navigation)", "motion": "remove or opacity/color <= 100ms" },
      { "frequency": "occasional (modal, drawer, toast)", "motion": "standard role tokens" },
      { "frequency": "rare (onboarding, celebration)", "motion": "may add delight; spring bounce <= 0.3" }
    ]
  },

  "personality": {
    "note": "engine selects one per brief; multiplies durations and caps bounce",
    "crisp":      { "durationScale": 0.8,  "bounceMax": 0,    "ease": "out", "for": "dense B2B, dashboards, dev tools" },
    "balanced":   { "durationScale": 1.0,  "bounceMax": 0.1,  "ease": "out", "for": "default SaaS, content sites" },
    "expressive": { "durationScale": 1.25, "bounceMax": 0.25, "ease": "outExpo", "for": "consumer, playful, creative landing pages" },
    "src": "engine"
  },

  "reducedMotion": {
    "src": "verified/engine",
    "strategy": "no-preference approach: decorative motion lives inside (prefers-reduced-motion: no-preference); JS libs read the preference",
    "transform": { "slide": "fade 200ms", "scale": "none", "parallax": "static", "stagger": "none", "bounce": "none" },
    "keep": ["opacity", "color", "background-color", "progress indicators"],
    "autoplayMedia": "poster only, user-initiated play",
    "loops": "stop (static frame) except essential loading indicators",
    "smoothScroll": "auto",
    "libraries": {
      "motion": "<MotionConfig reducedMotion=\"user\"> (disables transform + layout animations, keeps opacity/color); useReducedMotion() for swaps",
      "gsap": "gsap.matchMedia() with (prefers-reduced-motion: reduce) condition; static fallback layout",
      "css": "@media (prefers-reduced-motion: no-preference) { ... }; --travel: 0 under reduce"
    }
  },

  "performance": {
    "src": "verified/engine",
    "compositorOnly": ["transform", "opacity", "translate", "scale", "rotate"],
    "useSparingly": ["filter", "clip-path", "backdrop-filter", "box-shadow", "background-color"],
    "neverAnimate": ["width", "height", "top", "left", "right", "bottom", "margin", "padding", "font-size", "border-width"],
    "frameBudgetMs": 16.6,
    "inp": { "good": 200, "poor": 500 },
    "willChange": { "allowed": ["transform", "opacity", "filter"], "never": ["all"], "when": "only after observed first-frame stutter" },
    "blurMaxPx": 20,
    "maxConcurrentAnimatedLayers": 12
  },

  "lint": {
    "src": "engine",
    "regex": [
      { "id": "transition-all", "pattern": "transition(-property)?\\s*:\\s*all", "severity": "error" },
      { "id": "scale-zero", "pattern": "scale\\(0\\)|scale:\\s*0\\b|initial=\\{\\{[^}]*scale:\\s*0\\b", "severity": "error" },
      { "id": "ease-in-enter", "pattern": "ease-in(?!-out)", "severity": "warn", "note": "allowed only for elements leaving the viewport" },
      { "id": "layout-prop-animated", "pattern": "(transition|animate)[^;]*\\b(width|height|top|left|margin|padding)\\b", "severity": "warn" },
      { "id": "will-change-all", "pattern": "will-change\\s*:\\s*all", "severity": "error" },
      { "id": "bounce-high", "pattern": "bounce:\\s*(0\\.[4-9]|1)", "severity": "warn" },
      { "id": "global-kill-switch", "pattern": "transition-duration:\\s*0?\\.01ms", "severity": "warn" },
      { "id": "infinite-no-guard", "pattern": "animation[^;]*infinite", "severity": "info", "note": "needs reduced-motion guard and pause control if > 5s next to content" }
    ],
    "computed": [
      { "id": "ui-duration-ceiling", "rule": "transition/animation duration <= 300ms unless role in {drawer, hero, scrollReveal, pageTransitionMarketing, toast}" },
      { "id": "exit-not-longer-than-enter", "rule": "exit <= enter for paired overlays" },
      { "id": "distinct-timing-pairs", "rule": "<= 6 distinct (duration, easing) pairs per page" },
      { "id": "origin-aware", "rule": "anchored popups have transform-origin != center" },
      { "id": "press-state", "rule": ":active scale in [0.95, 0.98] for pressables" }
    ]
  }
}
