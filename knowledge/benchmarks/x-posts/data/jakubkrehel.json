 20 15:09:43 +0000 2026","created_timestamp":1787238583,"likes":992,"reposts":48,"replies":15,"quotes":2,"bookmarks":1189,"views":40639,"is_note_tweet":true,"replying_to":null,"quote":null,"media":null,"reposted_by":null},{"id":"2089721350927581434","url":"https://x.com/jakubkrehel/status/2089721350927581434","author_handle":"jakubkrehel","reposted":false,"text":"A couple of small details from the Interfere dashboard","created_at":"Tue Aug 18 14:29:29 +0000 2026","created_timestamp":1787063369,"likes":314,"reposts":4,"replies":12,"quotes":1,"bookmarks":255,"views":17493,"is_note_tweet":false,"replying_to":null,"quote":null,"media":{"all":[{"type":"video","width":2648,"height":1440,"duration":11.166,"url":"https://video.twimg.com/amplify_video/2089720862022717440/vid/avc1/2648x1440/Rxd8jaKN4O408nrm.mp4?tag=29","thumbnail_url":"https://pbs.twimg.com/amplify_video_thumb/2089720862022717440/img/z_Au8vSfcR5PC7lN.jpg"}]},"reposted_by":null},{"id":"2089009286940639674","url":"https://x.com/jakubkrehel/status/2089009286940639674","author_handle":"jakubkrehel","reposted":false,"text":"I made an interface cheat sheet full of small things you can do right away to make your interfaces better.\n\nIt’s based on the /better collection of skills and it's a mix of best practices and some of my personal preferences.\n\nhttps://interfaces.dev/cheat-sheet","created_at":"Sun Aug 16 15:20:00 +0000 2026","created_timestamp":1786893600,"likes":1407,"reposts":45,"replies":16,"quotes":2,"bookmarks":1923,"views":57867,"is_note_tweet":false,"replying_to":null,"quote":null,"media":{"all":[{"type":"video","width":2560,"height":1680,"duration":7,"url":"https://video.twimg.com/amplify_video/2088988409905750016/vid/avc1/2560x1680/zrcj-Af2n8Rsreec.mp4?tag=29","thumbnail_url":"https://pbs.twimg.com/amplify_video_thumb/2088988409905750016/img/4G6_aRUJajVlokXq.jpg"}]},"reposted_by":null},{"id":"2087913322356068402","url":"https://x.com/jakubkrehel/status/2087913322356068402","author_handle":"jakubkrehel","reposted":false,"text":"A few principles I follow when working with agents","created_at":"Thu Aug 13 14:45:02 +0000 2026","created_timestamp":1786632302,"likes":412,"reposts":22,"replies":12,"quotes":5,"bookmarks":237,"views":13068,"is_note_tweet":false,"replying_to":null,"quote":null,"media":{"all":[{"type":"photo","width":1370,"height":1532,"url":"https://pbs.twimg.com/media/HPnBfRgWEAAVFf8.png?name=orig"}]},"reposted_by":null},{"id":"2087913427364704502","url":"https://x.com/jakubkrehel/status/2087913427364704502","author_handle":"jakubkrehel","reposted":false,"text":"I write more about these below https://jakub.kr/writing/less-is-more","created_at":"Thu Aug 13 14:45:27 +0000 2026","created_timestamp":1786632327,"likes":10,"reposts":1,"replies":0,"quotes":0,"bookmarks":6,"views":1995,"is_note_tweet":false,"replying_to":{"screen_name":"jakubkrehel","status":"2087913322356068402"},"quote":null,"media":null,"reposted_by":null},{"id":"2087200943729164298","url":"https://x.com/jakubkrehel/status/2087200943729164298","author_handle":"jakubkrehel","reposted":false,"text":"I made a new skill: /interface-review\n\nIt reviews your work across multiple categories like UI, typography, layout, color, writing and accessibility and gives you a detailed analysis of the findings.\n\nhttps://github.com/jakubkrehel/skills","created_at":"Tue Aug 11 15:34:17 +0000 2026","created_timestamp":1786462457,"likes":1729,"reposts":77,"replies":18,"quotes":3,"bookmarks":2287,"views":79277,"is_note_tweet":false,"replying_to":null,"quote":null,"media":null,"reposted_by":null},{"id":"2086833399675646207","url":"https://x.com/jakubkrehel/status/2086833399675646207","author_handle":"jakubkrehel","reposted":false,"text":"Introducing a new Interfaces issue:\n\nAccessibility as Craft\n\nAccessibility is often overlooked, but it deserves the same care as every other part of an interface.\n\nThis issue goes in depth on how accessibility works on the web and covers best practices and useful tips.","