80,"height":1320,"duration":5.004,"url":"https://video.twimg.com/amplify_video/2075259654309847042/vid/avc1/880x1320/IEvvRM968xAJJOiK.mp4?tag=28","thumbnail_url":"https://pbs.twimg.com/amplify_video_thumb/2075259654309847042/img/XLDDd470WnlPj3Ai.jpg"}]},"reposted_by":null},{"id":"2059275509792383312","url":"https://x.com/oguzyagizkara/status/2059275509792383312","author_handle":"oguzyagizkara","reposted":false,"text":"👾","created_at":"Tue May 26 14:08:35 +0000 2026","created_timestamp":1779804515,"likes":203,"reposts":1,"replies":10,"quotes":0,"bookmarks":87,"views":13868,"is_note_tweet":false,"replying_to":null,"quote":null,"media":{"all":[{"type":"photo","width":4096,"height":2195,"url":"https://pbs.twimg.com/media/HJQEE5BWgAAHDRn.jpg?name=orig"}]},"reposted_by":null},{"id":"2056419140684890425","url":"https://x.com/oguzyagizkara/status/2056419140684890425","author_handle":"oguzyagizkara","reposted":false,"text":"Thanks a lot for the 50K! I never thought this was gonna happen ♥︎","created_at":"Mon May 18 16:58:24 +0000 2026","created_timestamp":1779123504,"likes":119,"reposts":0,"replies":18,"quotes":0,"bookmarks":1,"views":9058,"is_note_tweet":false,"replying_to":null,"quote":null,"media":null,"reposted_by":null},{"id":"2054183510269661288","url":"https://x.com/oguzyagizkara/status/2054183510269661288","author_handle":"oguzyagizkara","reposted":false,"text":"Right-Click 🖱️✨","created_at":"Tue May 12 12:54:48 +0000 2026","created_timestamp":1778590488,"likes":300,"reposts":11,"replies":7,"quotes":1,"bookmarks":118,"views":15179,"is_note_tweet":false,"replying_to":null,"quote":null,"media":{"all":[{"type":"video","width":2120,"height":1220,"duration":3.316,"url":"https://video.twimg.com/amplify_video/2054183357798395904/vid/avc1/2120x1220/cmapqP4ywP8cobM0.mp4?tag=27","thumbnail_url":"https://pbs.twimg.com/amplify_video_thumb/2054183357798395904/img/png-FEYzaoX89XPv.jpg"}]},"reposted_by":null},{"id":"2052783372653453456","url":"https://x.com/oguzyagizkara/status/2052783372653453456","author_handle":"oguzyagizkara","reposted":false,"text":"We've collaborated with @readme to refresh their home\n\nTons of details and lots of effort, I hope you guys like it!\n\nDesign and development by @LueStudio","created_at":"Fri May 08 16:11:09 +0000 2026","created_timestamp":1778256669,"likes":484,"reposts":13,"replies":38,"quotes":5,"bookmarks":206,"views":42309,"is_note_tweet":false,"replying_to":null,"quote":null,"media":{"all":[{"type":"video","width":1920,"height":1080,"duration":106,"url":"https://video.twimg.com/amplify_video/2052782325969162245/vid/avc1/1920x1080/zldD_wvV59wnLD_0.mp4?tag=27","thumbnail_url":"https://pbs.twimg.com/amplify_video_thumb/2052782325969162245/img/JTXUNr1v7tDA5HXE.jpg"}]},"reposted_by":null},{"id":"2052783938020511954","url":"https://x.com/oguzyagizkara/status/2052783938020511954","author_handle":"oguzyagizkara","reposted":false,"text":"@readme @LueStudio Live at → readme [dot] com","created_at":"Fri May 08 16:13:24 +0000 2026","created_timestamp":1778256804,"likes":18,"reposts":0,"replies":0,"quotes":0,"bookmarks":10,"views":6822,"is_note_tweet":false,"replying_to":{"screen_name":"oguzyagizkara","status":"2052783372653453456"},"quote":null,"media":{"all":[{"type":"photo","width":4096,"height":2150,"url":"https://pbs.twimg.com/media/HHz0EKOXYAAnv72.jpg?name=orig"}]},"reposted_by":null},{"id":"2051654134554620364","url":"https://x.com/oguzyagizkara/status/2051654134554620364","author_handle":"oguzyagizkara","reposted":false,"text":"I have a kind of love-hate relationship with AI\n\nI love AI a lot because it's amazing. I could write hundreds of things about it\n\nBut its impact on the industry and the world is too much\n\nI see the people around me going through a huge psychological test and that's really sad.\n\nIt would be absolutely ridiculous if such massive changes didn't bring about some upheaval but I don't think the situation we’re in is entirely right either\n\nWe expect AI to make us faster and more productive\n\nWe hope it helps us in creative fields\n\nIt's like some kind of drug, it brings immediate relief but I think in the long run it harms everyone in a different way and we're progressing too fast for anyone to catch their breath, and unfortunately this isn’t a voluntary ride\n\nSpeaking as someone who sits on both sides of this, creator and consumer sometimes everything feels too artificial.\n\nI’m really sorry for those affected by layoffs at Coinbase. I hope the productive “humans” are affected as little as possible by this\n\nI'd like to write more about this, but I have things to do and I need to catch up with AI :)","created_at":"Tue May 05 13:23:58 +0000 2026","created_timestamp":1777987438,"likes":179,"reposts":6,"replies":9,"quotes":3,"bookmarks":35,"views":25775,"is_note_tweet":true,"replying_to":null,"quote":{"id":"2051616759145185723","text":"This is an email I sent earlier today to all employees at Coinbase:\n\nTeam,\n\nToday I’ve made the difficult decision to reduce the size of Coinbase by ~14%. I want to walk you through why we're doing this now, what it means for those affected, and how this positions us for the future.\n\nWhy now\nTwo forces are converging at the same time. We need to be front footed to respond to both.\n\nFirst, the market. Coinbase is well-capitalized, has diversified revenue streams, and is well-positioned to weather any storm. Crypto is also on the verge of the next wave of adoption, with stablecoins, prediction markets, tokenization, and more taking off. However, our business is still volatile from quarter to quarter. While we've managed through that cyclicality many times before and come out stronger on the other side, we’re currently in a down market and need to adjust our cost structure now so that we emerge from this period leaner, faster, and more efficient for our next phase of growth.\n\nSecond, AI is changing how we work. Over the past year, I’ve watched engineers use AI to ship in days what used to take a team weeks. Non-technical teams are now shipping production code and many of our workflows are being automated. The pace of what's possible with a small, focused team has changed dramatically, and it's accelerating every day.\n\nAll of this has led us to an inflection point, not just for Coinbase, but for every company. The biggest risk now is not taking action. We are adjusting early and deliberately to rebuild Coinbase to be lean, fast, and AI-native. We need to return to the speed and focus of our startup founding, with AI at our core.\n\nWhat this means\nTo get there, we are not just reducing headcount and cutting costs, we’re fundamentally changing how we operate: rebuilding Coinbase as an intelligence, with humans around the edge aligning it. What does this mean in practice?\n\n- Fewer layers, faster decisions: We are flattening our org structure to 5 layers max below CEO/COO. Layers slow things down and create coordination tax. The future is small, high context teams that can move quickly. Leaders will own much more, with as many as 15+ direct reports. Fewer layers also means a leaner cost structure that is built to perform through all market cycles.\n\n- No pure managers: Every leader at Coinbase must also be a strong and active individual contributor. Managers should be like player-coaches, getting their hands dirty alongside their teams.\n\n- AI-native pods: We’ll be concentrating around AI-native talent who can manage fleets of agents to drive outsized impact. We’ll also be experimenting with reduced pod sizes, including “one person teams” with engineers, designers, and product managers all in one role.\n\nIn short: AI is bringing a profound shift in how companies operate, and we’re reshaping Coinbase to lead in this new era. This is a new way of working, and we need to leverage AI across every facet of our jobs.\n\nTo those who are affected\nI know there are real people behind these decisions — talented colleagues who have poured themselves into this company and our mission. To those of you who will be leaving: thank you. You’ve helped build Coinbase into what it is today, and I am sincerely grateful for everything you've done.\n\nAll impacted team members will receive an email to their personal account in the next hour with more information, and an invitation to meet with an HRBP and a senior leader in your organization. Coinbase system access has been removed today. I know this feels sudden and harsh, but it is the only responsible choice given our duty to protect customer information.\n\nTo those affected, we will be providing a comprehensive package to support you through this transition. US employees will receive a minimum of 16 weeks base pay (plus 2 weeks per year worked), their next equity vest, and 6 months of COBRA. Employees on a work visa will get extra transition support. Those outside of the US will receive similar support, based on local factors and subject to any consultation requirements.\n\nCoinbase prides itself on talent density. Our employees are among the most talented people in the world, and I have no doubt that your skills and experience will be highly sought after as you pursue your next chapters.\n\nHow we move forward\nTo the team that is staying, I know this is a difficult day. We’re saying goodbye to colleagues and friends you've been in the trenches with. But here’s what I want you to know as we move forward together:\n\nOver the past 13 years, we have weathered four crypto winters, gone public, and built the most trusted platform in our industry. We’ve made it this far by making hard decisions and by always staying focused on our mission. This time will be no different – nothing has changed about the long term outlook of our company or industry. And most importantly, our mission has never been more important for the world. Increasing economic freedom requires a new financial system, and we’re building it.\n\nThe Coinbase that emerges from this will be more capable than ever to achieve our mission.\n\nBrian","author":"brian_armstrong","media_n":0},"media":null,"reposted_by":null},{"id":"2051276051603431660","url":"https://x.com/oguzyagizkara/status/2051276051603431660","author_handle":"oguzyagizkara","reposted":false,"text":"Reveal [01]","created_at":"Mon May 04 12:21:36 +0000 2026","created_timestamp":1777897296,"likes":146,"reposts":2,"replies":13,"quotes":0,"bookmarks":33,"views":11234,"is_note_tweet":false,"replying_to":null,"quote":null,"media":{"all":[{"type":"video","width":2160,"height":1464,"duration":5.22,"url":"https://video.twimg.com/amplify_video/2051275793179742209/vid/avc1/2160x1464/QrnxBMSX1q7_R62L.mp4?tag=27","thumbnail_url":"https://pbs.twimg.com/amplify_video_thumb/2051275793179742209/img/YN8We6qexWbWMthZ.jpg"}]},"reposted_by":null},{"id":"2048765349214974240","url":"https://x.com/oguzyagizkara/status/2048765349214974240","author_handle":"oguzyagizkara","reposted":false,"text":"","created_at":"Mon Apr 27 14:04:58 +0000 2026","created_timestamp":1777298698,"likes":167,"reposts":1,"replies":10,"quotes":0,"bookmarks":24,"views":9591,"is_note_tweet":false,"replying_to":null,"quote":null,"media":{"all":[{"type":"video","width":840,"height":840,"duration":4.5,"url":"https://video.twimg.com/amplify_video/2048765293972037632/vid/avc1/840x840/MqRCR4Z07t17jh6I.mp4?tag=21","thumbnail_url":"https://pbs.twimg.com/amplify_video_thumb/2048765293972037632/img/bDVdYQtyHVomtE5u.jpg"}]},"reposted_by":null},{"id":"2045084983920845204","url":"https://x.com/oguzyagizkara/status/2045084983920845204","author_handle":"oguzyagizkara","reposted":false,"text":"Docs with Assistant","created_at":"Fri Apr 17 10:20:30 +0000 2026","created_timestamp":1776421230,"likes":211,"reposts":8,"replies":7,"quotes":0,"bookmarks":133,"views":14193,"is_note_tweet":false,"replying_to":null,"quote":null,"media":{"all":[{"type":"photo","width":4096,"height":2911,"url":"https://pbs.twimg.com/media/HGGZxYzaQAALTJp.jpg?name=orig"}]},"reposted_by":null},{"id":"204508422832119035