{
  "schema": "dark-recipes/v1",
  "updated": "2026-10-09",
  "about": "Six premium dark palettes for SaaS marketing heroes and product UI. Each value is derived from measured benchmarks in knowledge/web/dark-mode-premium.md and dark-mode-craft.md (canvas L 0.134-0.195 or #000; surfaces +0.03/+0.065/+0.10 L; hairline white .08-.10; strong .14-.18; ink L .95-.96; sub L .71-.73 at >=6.7:1 on surface-2; soft L .54-.57 for <=13px metadata only; accent L .68-.80 C .14-.22). One palette per client project; use it with the bound house system, not instead of it.",
  "usage": {
    "canvas": "page background and html/meta theme-color",
    "surface-1": "cards, product frame body, nav pill",
    "surface-2": "raised panels, popovers, sidebar in product UI",
    "surface-3": "hover on solid surfaces, selected tab, input wells on raised panels",
    "line": "every resting hairline: cards, rows, dividers, nav bottom",
    "line-strong": "inputs, focused/selected, secondary buttons, frame edge over art",
    "ink": "headings, primary UI text (never pure #fff for body)",
    "sub": "subtitle, nav links, captions, table secondary columns",
    "soft": "IDs, timestamps, axis labels <=13px only",
    "accent": "links, focus ring, data series, one chip family, small fills with accent-ink label",
    "accent-deep": "large chromatic fills with accent-deep-ink label",
    "glow": "one key light, behind the product not the headline",
    "frame-edge": "box-shadow for the hero product window"
  },
