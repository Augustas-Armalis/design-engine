      "radiusPreset": "default",
      "depthStyle": "border",
      "density": "default",
      "motionPersonality": "calm",
      "typeVoice": "Plain, exact, calm under pressure; sentences an on-call engineer would write."
    },
    "bestFor": [
      "incident response and on-call",
      "observability",
      "infra AI agents",
      "security operations"
    ],
    "avoidFor": [
      "consumer lifestyle",
      "warm editorial brands"
    ],
    "owned": [
      "A hairline cell grid (rails + rules) that frames every section, Marcel-style; content sits in cells, never floats",
      "Pixel-matrix art made of square cells that light in amber where a human is needed and cool to white when resolved",
      "Numbered section and tab labels in mono (01, 02...)",
      "Product windows at Rico grade: #161616-#1c1c1c greys, 1px #ffffff0f edges, white pill primary"
    ],
    "never": [
      "purple or blue gradients behind type",
      "glow on a resting button",
      "more than one accent hue"
    ],
