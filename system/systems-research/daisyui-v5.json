{
  "name": "daisyUI 5",
  "slug": "daisyui-v5",
  "vendor": "daisyUI (Pouya Saadeghi)",
  "url": "https://daisyui.com",
  "licence": "MIT (npm daisyui@5.7.47, LICENSE (c) 2020 Pouya Saadeghi)",
  "studiedOn": "2026-10-08",
  "personality": [
    "themeable",
    "playful",
    "semantic",
    "class-light",
    "costume-ready"
  ],
  "bestFor": [
    "prototypes and side projects that need many looks fast",
    "theme-switching products (one markup, 35 skins)",
    "studying how a handful of knobs (3 radii, 2 sizes, border, depth, noise) change personality"
  ],
  "avoidFor": [
    "premium SaaS marketing that must not look like a template (named themes are widely recognisable)",
    "dense data apps needing fine state control",
    "React-component-API projects (it is CSS class names, no behaviour)"
  ],
  "typography": {
    "families": [
      "none set: inherits Tailwind --font-sans"
    ],
    "scale": [
      {
        "role": "btn-xs",
        "sizePx": 11,
        "lineHeightPx": "unknown",
        "weight": 600,
        "trackingEm": 0
      },
      {
        "role": "btn-sm",
        "sizePx": 12,
        "lineHeightPx": "unknown",
        "weight": 600,
        "trackingEm": 0
      },
      {
        "role": "btn-md (default)",
        "sizePx": 14,
        "lineHeightPx": "unknown",
        "weight": 600,
        "trackingEm": 0
      },
      {
        "role": "btn-lg",
        "sizePx": 18,
        "lineHeightPx": "unknown",
        "weight": 600,
        "trackingEm": 0
      },
      {
        "role": "btn-xl",
        "sizePx": 22,
        "lineHeightPx": "unknown",
        "weight": 600,
        "trackingEm": 0
      },
      {
        "role": "card-body xs/sm/md",
        "sizePx": "11 / 12 / 14",
        "lineHeightPx": "unknown",
        "weight": 400,
        "trackingEm": 0
      },
      {
        "role": "card-title xs/sm",
        "sizePx": "14 / 16",
        "lineHeightPx": "unknown",
        "weight": "unknown",
        "trackingEm": 0
      }
    ],
    "notes": "daisyUI owns no type scale; it sizes text per component size class (xs..xl) and leaves headings to Tailwind. Inputs use the same five font sizes as buttons (11/12/14/18/22px)."
  },
