   "--shadow-3: 0 0 0 1px gray-a3, 0 2px 3px -2px gray-a3, 0 3px 12px -4px black-a2, 0 4px 16px -8px black-a2",
   "--shadow-4: 0 0 0 1px gray-a3, 0 8px 40px black-a1, 0 12px 32px -16px gray-a3",
   "--shadow-5 (popover/dialog): 0 0 0 1px gray-a3, 0 12px 60px black-a3, 0 12px 32px -16px gray-a5",
   "--shadow-6: 0 0 0 1px gray-a3, 0 12px 60px black-a3, 0 16px 64px gray-a2, 0 16px 36px -20px gray-a7",
