{
 "name": "Radix Themes + Radix Colors",
 "slug": "radix-themes",
 "vendor": "WorkOS (Radix UI team; Radix Colors originally Modulz)",
 "url": "https://www.radix-ui.com/themes/docs/overview/getting-started",
 "licence": "MIT (Radix Themes v3.3.0 package.json and repo LICENSE; Radix Colors repo LICENSE MIT)",
 "studiedOn": "2026-10-08",
 "personality": [
  "calm",
  "systematic",
  "soft-neutral",
  "engineered",
  "tunable",
  "friendly-corporate"
 ],
 "bestFor": [
  "SaaS dashboards and admin tools needing every state done",
  "products that must switch brand colour and radius globally with 2-3 props",
  "teams wanting accessible tinted neutrals and dark mode without hand tuning",
  "internal tools, settings, dense data UI via scaling knob"
 ],
 "avoidFor": [
  "brand-led marketing sites needing a distinctive voice (reads as default Radix)",
  "editorial or expressive typography (system-font stack, no display face)",
  "products needing a custom brand hue (docs say do not edit scales; add a custom scale beside them)"
 ],
 "typography": {
  "families": [
   "text: -apple-system, BlinkMacSystemFont, 'Segoe UI (Custom)', Roboto, 'Helvetica Neue', 'Open Sans (Custom)', system-ui, sans-serif",
   "code: 'Menlo', 'Consolas (Custom)', 'Bitstream Vera Sans Mono', monospace",
   "em/quote: 'Times New Roman', 'Times', serif (italic, size-adjust 1.18, tracking -0.025em)"
  ],
