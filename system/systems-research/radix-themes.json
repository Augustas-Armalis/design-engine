   },
   {
    "role": "heading size 9",
    "sizePx": 60,
    "lineHeightPx": 60,
    "weight": 700,
    "trackingEm": "-0.025em (+ --heading-letter-spacing, default 0em)"
   }
  ],
  "notes": "9 steps shared by Text, Heading, Link, Code, Kbd, Blockquote. Letter-spacing tightens as size grows (0.0025em at 12px to -0.025em at 60px). Line heights are absolute px, not ratios; heading line heights are tighter at 2-6 (18/22/24/26/30). Weight tokens: light 300, regular 400, medium 500, bold 700. Body default is size 3 (16px) weight 400, line-height 1.5, antialiased. Heading default weight = bold (700). Leading-trim variables (--default-leading-trim-start 0.42em / end 0.36em) allow cap-height-aligned text boxes via the trim prop. All sizes multiply by --scaling."
 },
