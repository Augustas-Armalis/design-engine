{
 "name": "shadcn/ui",
 "slug": "shadcn-ui",
 "vendor": "shadcn (Vercel)",
 "url": "https://ui.shadcn.com/docs/theming",
 "licence": "MIT (shadcn-ui/ui LICENSE.md, Copyright 2023 shadcn)",
 "studiedOn": "2026-10-08",
 "personality": [
  "neutral",
  "utilitarian",
  "compact",
  "monochrome",
  "composable",
  "unopinionated"
 ],
 "bestFor": [
  "developer-owned SaaS and AI product UI",
  "dashboards, settings, forms, chat UIs",
  "projects that need to re-skin by changing ~20 CSS variables and one preset",
  "agent-generated UI (registry, CLI, skills, MCP all first-class)"
 ],
 "avoidFor": [
  "brand-led marketing pages (default is deliberately generic)",
  "products needing a bespoke motion or illustration language",
  "teams that want a versioned package rather than owning component source"
 ],
 "typography": {
  "families": [
   "No font mandated by the component registry; docs site uses Geist Sans + Geist Mono via CSS vars (--font-geist, --font-geist-mono)",
   "Tailwind default sans stack fallback; presets (create page) pick fonts, applied with `shadcn apply <preset> --only font`",
   "Base-nova card titles use a `cn-font-heading` class, implying a separate heading font slot in the style layer (exact token unverified)"
  ],
  "scale": [
   {
    "role": "typography h1",
    "sizePx": 36,
    "lineHeightPx": 40,
    "weight": 800,
    "trackingEm": "-0.025em (tracking-tight)"
   },
   {
    "role": "typography h2",
    "sizePx": 30,
    "lineHeightPx": 36,
    "weight": 600,
    "trackingEm": "-0.025em, border-b pb-2"
   },
   {
    "role": "typography h3",
    "sizePx": 24,
    "lineHeightPx": 32,
    "weight": 600,
    "trackingEm": "-0.025em"
   },
   {
    "role": "typography h4",
    "sizePx": 20,
    "lineHeightPx": 28,
    "weight": 600,
    "trackingEm": "-0.025em"
   },
   {
    "role": "typography lead",
    "sizePx": 20,
    "lineHeightPx": 28,
    "weight": 400,
    "trackingEm": "0 (text-muted-foreground)"
   },
   {
    "role": "typography large",
    "sizePx": 18,
    "lineHeightPx": 28,
    "weight": 600,
    "trackingEm": "0"
   },
   {
    "role": "body p",
    "sizePx": 16,
    "lineHeightPx": 28,
    "weight": 400,
    "trackingEm": "0 (leading-7, paragraphs mt-6)"
   },
   {
    "role": "small / default UI text (text-sm)",
    "sizePx": 14,
    "lineHeightPx": 20,
    "weight": 500,
    "trackingEm": "0 (leading-none in labels)"
   },
   {
    "role": "muted",
    "sizePx": 14,
    "lineHeightPx": 20,
    "weight": 400,
    "trackingEm": "0 (text-muted-foreground)"
   },
   {
    "role": "button xs/sm text (base-nova)",
    "sizePx": 12.8,
    "lineHeightPx": "unknown",
    "weight": 500,
    "trackingEm": "0 (sm = text-[0.8rem], xs = text-xs 12px)"
   },
   {
    "role": "inline code",
    "sizePx": 14,
    "lineHeightPx": "unknown",
    "weight": 600,
    "trackingEm": "0 (font-mono, rounded bg-muted px-[0.3rem] py-[0.2rem])"
   }
  ],
  "notes": "shadcn has no type-scale tokens; it uses the Tailwind scale (text-xs 12/16, sm 14/20, base 16/24, lg 18/28, xl 20/28, 2xl 24/32, 3xl 30/36, 4xl 36/40). Values above are the documented Typography page class strings (docs/components/typography). UI controls default to text-sm (14px) with font-medium; base-nova inputs use text-base (16px) on mobile guard. New in 2026: `shadcn/typeset`, a single CSS file for rendered markdown with three controls (--typeset-size, --typeset-leading, --typeset-flow) plus font vars; example .typeset-docs = 15px / 1.75 / 1.25em."
 },
