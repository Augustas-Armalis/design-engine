{
  "$schema": "./tokens.schema.json",
  "$comment": "EXAMPLE VALUES ONLY. A fresh, fictional system (\"Fieldnote\", a research-notes app) that shows how the template is filled. It is NOT AlignUI and not a recommendation: replace every value per brief. Colour ramps were generated in OKLCH (neutral hue 80, brand hue 325, states 27/78/150/238) and every contract pair in semantic.contrastReport was computed from the hex values below.",
  "meta": {
    "name": "Fieldnote (example)",
    "version": "0.1.0",
    "status": "example",
    "brief": {
      "product": "Fieldnote: a notes and citations app for independent researchers (fictional)",
      "audience": "solo researchers and small labs",
      "action": "Start a free notebook",
      "proof": "A real notebook screen showing a note, its source and the citation it generated (sample data, labelled sample)"
    },
    "personality": {
      "brandHue": 325,
      "neutralTemperature": "warm",
      "typeVoice": "A bookish serif for headlines against a plain humanist sans for work; mono only for citations and IDs.",
      "radiusPreset": "tight",
      "depthStyle": "border",
      "density": "default",
      "motionPersonality": "calm"
    },
    "signature": "Warm-paper canvas with ink text and plum accent; hairline borders instead of shadows; citation chips set in mono.",
    "overrides": []
  },
