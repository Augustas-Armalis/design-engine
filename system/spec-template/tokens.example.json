  "component": {
    "button": {
      "sizes": {
        "sm": {
          "height": "{primitive.size.control.sm}",
          "paddingX": "12px",
          "gap": "6px",
          "icon": "{primitive.size.icon.sm}",
          "radius": "{primitive.radius.ramp.sm}",
          "text": "label-sm"
        },
        "md": {
          "height": "{primitive.size.control.md}",
          "paddingX": "16px",
          "gap": "8px",
          "icon": "{primitive.size.icon.md}",
          "radius": "{primitive.radius.ramp.md}",
          "text": "label-md"
        },
        "lg": {
          "height": "{primitive.size.control.lg}",
          "paddingX": "20px",
          "gap": "8px",
          "icon": "{primitive.size.icon.md}",
          "radius": "{primitive.radius.ramp.md}",
          "text": "label-md"
        }
      },
      "notes": "Icon box has -2px margin on the icon side (optical alignment). Three sizes only; no xs."
    },
    "input": {
      "sizes": {
        "sm": {
          "height": "{primitive.size.control.sm}",
          "paddingX": "10px",
          "gap": "6px",
          "icon": "{primitive.size.icon.sm}",
          "radius": "{primitive.radius.ramp.sm}",
          "text": "body-sm"
        },
        "md": {
          "height": "{primitive.size.control.md}",
          "paddingX": "12px",
          "gap": "8px",
          "icon": "{primitive.size.icon.md}",
          "radius": "{primitive.radius.ramp.md}",
          "text": "body-md"
        },
        "lg": {
          "height": "{primitive.size.control.lg}",
          "paddingX": "14px",
          "gap": "8px",
          "icon": "{primitive.size.icon.md}",
          "radius": "{primitive.radius.ramp.md}",
          "text": "body-md"
        }
      },
      "notes": "Heights match button at each size so a button sits flush beside an input."
    },
    "badge": {
      "sizes": {
        "sm": {
          "height": "20px",
          "paddingX": "6px",
          "gap": "4px",
          "icon": "12px",
          "radius": "{primitive.radius.ramp.xs}",
          "text": "label-sm"
        },
        "md": {
          "height": "24px",
          "paddingX": "8px",
          "gap": "6px",
          "icon": "{primitive.size.icon.sm}",
          "radius": "{primitive.radius.ramp.sm}",
          "text": "label-sm"
        }
      },
      "notes": "Citation chip uses mono-sm and radius xs."
    },
    "overlay": {
      "sizes": {
        "menu": {
          "height": "auto",
          "paddingX": "4px",
          "gap": "2px",
          "icon": "{primitive.size.icon.md}",
          "radius": "{primitive.radius.ramp.lg}",
          "text": "body-sm"
        },
        "modal": {
          "height": "auto",
          "paddingX": "24px",
          "gap": "16px",
          "icon": "{primitive.size.icon.md}",
          "radius": "{primitive.radius.ramp.xl}",
          "text": "body-md"
        }
      },
      "notes": "Menu item radius = menu radius - menu padding (10 - 4 = 6px, matches radius.md)."
    }
  },
  "naming": {
    "roleFormat": "{group}-{role}[-{modifier}]; groups: surface, text, border, accent, state-{family}; state tokens end in solid | solid-hover | on-solid | tint | text | border",
    "sizeWords": [
      "sm",
      "md",
      "lg"
    ],
    "variantAxes": [
      "tone",
      "emphasis",
      "size"
    ],
    "cssVarPattern": "--{group}-{role}[-{modifier}] (e.g. --surface-canvas, --text-muted, --state-danger-solid)",
    "forbidden": [
      "raw hex or rgb() in components",
      "numeric colour names outside primitives (gray-3)",
      "font-size or line-height set outside primitive.type.scale",
      "box-shadow or border-radius literals outside the named ramps",
      "opacity values not in primitive.color.alphaSteps"
    ]
  }
}