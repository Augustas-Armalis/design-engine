          "weight": 600,
          "tracking": "0"
        },
        "body-lg": {
          "size": "18px",
          "lineHeight": "28px",
          "weight": 400,
          "tracking": "0"
        },
        "body-md": {
          "size": "16px",
          "lineHeight": "24px",
          "weight": 400,
          "tracking": "0"
        },
        "body-sm": {
          "size": "14px",
          "lineHeight": "20px",
          "weight": 400,
          "tracking": "0"
        },
        "label-md": {
          "size": "14px",
          "lineHeight": "20px",
          "weight": 600,
          "tracking": "0"
        },
        "label-sm": {
          "size": "12px",
          "lineHeight": "16px",
          "weight": 600,
          "tracking": "0.01em"
        },
        "eyebrow": {
          "size": "12px",
          "lineHeight": "16px",
          "weight": 600,
          "tracking": "0.08em",
          "case": "uppercase"
        },
        "mono-sm": {
          "size": "13px",
          "lineHeight": "20px",
          "weight": 500,
          "tracking": "0"
        }
      }
    },
    "shadow": {
      "none": "none",
      "hairline": "0 1px 0 0 {semantic.color.light.border.hairline}",
      "raised": [
        "0 0 0 1px {semantic.color.light.border.hairline}",
        "0 2px 0 0 {semantic.color.light.border.hairline}"
      ],
      "float": [
        "0 0 0 1px {semantic.color.light.border.hairline}",
        "0 12px 24px -12px rgba(32,30,26,0.24)"
      ],
      "modal": [
        "0 0 0 1px {semantic.color.light.border.hairline}",
        "0 32px 64px -24px rgba(32,30,26,0.40)"
      ]
    },
    "motion": {
      "duration": {
        "instant": "80ms",
        "fast": "140ms",
        "base": "220ms",
        "slow": "360ms"
      },
      "easing": {
        "standard": "cubic-bezier(0.2, 0, 0, 1)",
        "exit": "cubic-bezier(0.4, 0, 1, 1)"
      },
      "reducedMotion": "crossfade-only"
    },
    "z": {
      "base": 0,
      "raised": 10,
      "sticky": 20,
      "overlay": 40,
      "modal": 50,
      "toast": 60,
      "tooltip": 70
    },
    "breakpoint": {
      "sm": "640px",
      "md": "900px",
      "lg": "1200px"
    },
    "container": {
      "content": "1120px",
      "text": "64ch"
    }
  },
