      "popover": "0 0 0 1px rgba(255,255,255,0.145), 0 1px 1px rgba(0,0,0,0.02), 0 4px 8px -4px rgba(0,0,0,0.04), 0 16px 24px -8px rgba(0,0,0,0.06)",
      "command": "0 0 0 1px rgba(255,255,255,0.145), 0 1px 1px rgba(0,0,0,0.02), 0 8px 16px -4px rgba(0,0,0,0.04), 0 24px 32px -8px rgba(0,0,0,0.06)",
      "modal": "0 0 0 1px rgba(255,255,255,0.14), 0 32px 72px -12px rgba(0,0,0,0.06), 0 8px 32px -12px rgba(0,0,0,0.08), 0 8px 24px -12px rgba(0,0,0,0.12)",
