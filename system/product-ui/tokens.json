          "hairline": "rgba(255,255,255,0.04)"
        }
      },
      "rules": [
        "ring alpha ~1.8x the light value, drop-shadow layers unchanged",
        "panel-to-page lightness step 1-4 L*",
        "no glow on resting controls; accent only in data and the one primary"
      ],
      "source": "Linear DOM windows [M]; Geist dark [M]; kargul-crm-teardown.md; heyrico-product-design.md"
    }
  },
  "radius": {
    "peer": {
      "kbd": 4,
      "chipSquare": 4,
      "item": 6,
      "control": [
