{
  "$description": "Component-level numeric standards for engine product UI (app screens and product shots in heroes). Values are CSS px at 1x. 'default' is what a build uses unless DIRECTION.md overrides it; 'range' is the measured studio-grade band; 'founder' marks the founder-owned soft ladder that wins over peer averages. Derived from knowledge/web/product-ui-deep.md (PU-01..40), product-ui-in-marketing.md (PUI-01..50), attio-product-ui.md, kargul-*.md, heyrico-*.md, flohoeller-craft.md, consistency-mechanics.md and founder-taste.md.",
  "$version": "2026-10-10",
  "$usage": [
    "Pick one density per product: 'dense' (Linear/Kargul/Rico, 12-13 px text, 28-30 px rows) or 'comfortable' (Attio/Geist, 14 px text, 32-36 px rows). Change density through padding and gap, never through control height.",
    "Every numeric role below has light and dark values where the theme changes it; geometry never changes between themes.",
    "Rings are box-shadow '0 0 0 1px <ring>' so they never change layout; hairlines are 1 px borders.",
    "Radius values are as rendered (getComputedStyle), not Tailwind class names; a bound system theme.css may redefine --radius-*."
  ],
  "density": {
    "dense": {
      "baseText": 13,
      "metaText": 12,
      "navRow": 28,
      "navPitch": 30,
      "tableRow": 40,
      "listRow": 40,
      "control": 28,
      "icon": 14,
      "sources": "Linear, Rico, Kargul"
    },
    "comfortable": {
      "baseText": 14,
      "metaText": 12,
      "navRow": 32,
      "navPitch": 32,
      "tableRow": 36,
      "listRow": 44,
      "control": 32,
      "icon": 16,
      "sources": "Attio, Geist"
    },
    "default": "dense"
  },
  "space": {
    "scale": [
      0,
      2,
      4,
      6,
      8,
      12,
      16,
      20,
      24,
      32,
      40,
      48
    ],
    "subStepInsideControls": 2,
    "cardPadding": 16,
    "pageGutter": 24,
    "betweenCards": 20,
    "rowGap": 2,
    "source": "consistency-mechanics.md, heyrico-recreation-lessons.md, founder compact-grammar rule"
  },
  "type": {
    "family": {
      "ui": "Inter / Geist class grotesk, one variable family",
      "mono": "Geist Mono / Berkeley Mono class, 12 px, for IDs in code, branches, keys, logs",
      "display": "optional serif or display face for document/object titles only (Granola, Rico warm themes)"
    },
    "maxSizesPerView": 5,
    "maxWeightsPerView": 3,
    "roles": {
      "micro": {
        "size": 11,
        "lineHeight": 14,
        "weight": 500,
        "tracking": 0,
        "use": "keycaps alt, model badges, chart ticks floor"
      },
      "meta": {
        "size": 12,
        "lineHeight": 16,
        "weight": 400,
        "tracking": 0,
        "use": "dates, IDs, counts, secondary row line, axis ticks"
      },
      "label": {
        "size": 12,
        "lineHeight": 16,
        "weight": 500,
        "tracking": 0,
        "use": "group labels, column headers (dense), field labels, chip text"
      },
      "body": {
        "size": 13,
        "lineHeight": 20,
        "weight": 400,
        "tracking": 0,
        "use": "dense body, agent answers, descriptions"
      },
      "control": {
        "size": 13,
        "lineHeight": 20,
        "weight": 500,
        "tracking": 0,
        "use": "nav labels, buttons, tabs, menu items (dense)"
      },
      "bodyComfortable": {
        "size": 14,
        "lineHeight": 20,
        "weight": 400,
        "tracking": 0,
        "use": "comfortable density body and table cells"
      },
      "controlComfortable": {
        "size": 14,
        "lineHeight": 20,
        "weight": 500,
        "tracking": 0,
        "use": "comfortable nav, buttons, headers"
      },
      "title": {
        "size": 16,
        "lineHeight": 24,
        "weight": 500,
        "tracking": "-0.01em",
        "use": "page title in the top bar or content"
      },
      "dialogTitle": {
        "size": 18,
        "lineHeight": 24,
        "weight": 600,
        "tracking": "-0.02em",
        "use": "modal, sheet, empty-state title (Geist 20/26/600/-0.4px)"
      },
      "kpi": {
        "size": 20,
        "lineHeight": 24,
        "weight": 600,
        "tracking": "-0.01em",
        "numeric": "tabular-nums",
        "range": [
          18,
          24
        ],
        "use": "in-app KPI figure; hero money figures may go larger per founder rule"
      },
      "code": {
        "size": 12,
        "lineHeight": 18,
        "weight": 400,
        "tracking": 0,
        "family": "mono"
      }
    },
    "numerals": {
      "columns": "tabular-nums, right-aligned",
      "standaloneLargeValues": "proportional allowed (Rico)",
      "unitStyle": "unit/currency code after value in text.tertiary"
    },
    "sources": "Linear 12/13 at 400/510; Cursor 11/12/13; Geist 14/20, 20/26/600/-0.4px; Rico 12-18; Kargul 12/14"
  },
